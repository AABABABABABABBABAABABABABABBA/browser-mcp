{
  "name": "browser-mcp",
  "version": "0.1.0",
  "description": "Browser-driven MCP server with security scanning, request replay, and web pentest tools",
  "type": "module",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "install-browser": "playwright install chromium"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "playwright": "^1.49.0",
    "ws": "^8.22.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
